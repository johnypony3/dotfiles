# {{ ansible_managed }}

export ZSH="$HOME/.oh-my-zsh"

if [[ -n "$SSH_CONNECTION" ]]; then
    ZSH_THEME="simple"
else
    ZSH_THEME="robbyrussell"
fi

ZSH_TMUX_AUTOCONNECT=true
[[ -o interactive ]] && ZSH_TMUX_AUTOSTART=true
plugins=(git tmux)

source $ZSH/oh-my-zsh.sh

# --- aliases ---

alias ls='ls --color=never'
alias python=python3
alias pip=pip3

# --- env ---

export KUBECONFIG={{ kubeconfig_path }}

# --- tmux session picker (on new interactive shell outside tmux) ---

if [[ -z "$TMUX" ]]; then
  if tmux ls &>/dev/null; then
    session=$(tmux ls -F '#{session_name}' | fzf --prompt='session: ' --height=~40% --reverse)
    if [[ -n "$session" ]]; then
      tmux attach -t "$session"
    else
      tmux new-session
    fi
  else
    tmux new-session
  fi
fi
