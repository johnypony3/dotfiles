# Terminal rendering for cmux. cmux reads this file but does not own it.
# Font matches the iTerm2 profile so both terminals render Nerd Font glyphs identically.

font-family = JetBrainsMono Nerd Font Mono
font-size = 12

cursor-style = block
mouse-hide-while-typing = true
copy-on-select = clipboard
window-padding-x = 2
window-padding-y = 2
